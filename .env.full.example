# Copiar a .env y completar. Lo usa docker-compose.full.yml (stack completo).
# NO uses las claves de ejemplo: genera cadenas largas nuevas.

# ---------- Postgres ----------
PG_DATABASE=hospital_bi
PG_USER=hospital_admin
PG_PASSWORD=pon-una-clave-larga-aqui

# ---------- Grafana ----------
GF_ADMIN_PASSWORD=pon-otra-clave-larga-aqui

# ---------- Dominio (Caddy / HTTPS) ----------
DOMAIN=dashboard.tu-dominio.cl

# ---------- Loader (carga automatica del Excel) ----------
POLL_SECONDS=30          # cada cuanto revisa data/incoming/
STRICT=0                 # 1 = marca la carga como fallida si no cuadra vs total del Excel

# ---------- Reporte por correo (servicio reporter) ----------
REPORT_CRON=0 8 5 * *    # min hora dia mes dia-semana  -> 08:00 del dia 5
REPORT_TZ=America/Santiago
REPORT_FROM=now-13M      # rango temporal que sale en el PNG
REPORT_TO=now

# ---------- SMTP (lo usan reporter y, si activas, las alertas de Grafana) ----------
SMTP_ENABLED=false       # true = Grafana tambien puede mandar sus alertas por correo
SMTP_HOST=smtp.tu-correo.cl
SMTP_PORT=587            # 587 STARTTLS  |  465 SSL
SMTP_USER=usuario
SMTP_PASSWORD=clave-o-app-password
MAIL_FROM=bi-hospital@tu-correo.cl
MAIL_TO=finanzas@hospital.cl, direccion@hospital.cl
