# Copiar a .env y completar. Solo se usa en la opcion VM (docker-compose).
# En Render / HF Spaces estas variables se ponen en el panel del proveedor.

# --- Postgres ---
PG_DATABASE=hospital_bi
PG_USER=hospital_admin
PG_PASSWORD=pon-una-clave-larga-aqui

# --- Grafana ---
GF_ADMIN_PASSWORD=pon-otra-clave-larga-aqui

# --- Dominio (opcion VM con Caddy) ---
DOMAIN=dashboard.tu-dominio.cl
